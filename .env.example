# Example configuration of the Financial Ledger API (SRS OE-3, DR-6, SEC-5, CON-9).
# Copy it to .env (which git ignores - never commit .env), fill in the two keys, then load it into your shell:
#     set -a; . ./.env; set +a
# The values below are dummies; the API keys are deliberately empty.

# Address and port the service listens on (default 127.0.0.1:8000).
LEDGER_HOST=127.0.0.1
LEDGER_PORT=8000

# SQLite database file; created on first start. Tests never use it (NFR-SAFE-5).
LEDGER_DB_PATH=data/ledger.db

# Supported ISO 4217 currencies, comma-separated; must include INR and USD (FR-1.3).
LEDGER_CURRENCIES=INR,USD

# Swagger UI at /docs and the contract at /openapi.yaml (UI-1); set to false outside development.
LEDGER_DOCS_ENABLED=true

# API keys (FR-0.1): comma-separated, each at least 32 random characters. Generate one with
#     python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Never commit real keys or paste them into an AI tool (SEC-5, AI-4).
LEDGER_CLIENT_KEYS=
LEDGER_ADMIN_KEYS=
