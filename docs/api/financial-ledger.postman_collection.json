{
  "info": {
    "name": "Financial Ledger API - Team 007",
    "description": "Every endpoint of the Financial Ledger & Digital Wallet API (SRS UI-2), in the order of the Stage 4 demonstration (FR-1 to FR-5), plus error examples. Before running, set the collection variables clientKey and adminKey to the keys your server was started with (LEDGER_CLIENT_KEYS, LEDGER_ADMIN_KEYS) - never save real keys into this file (CON-9). Contract: docs/api/openapi.yaml.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 Demo flow (FR-1 to FR-5)",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "FR-6.4 - no API key needed."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"status ok\", function () { pm.expect(pm.response.json().status).to.eql(\"ok\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Create user Alice",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{clientKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "users"
              ]
            },
            "description": "FR-1.1 - CLIENT key. The email gets a unique run ID so the collection can run again.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Example\",\n  \"email\": \"alice.{{runId}}@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"runId\", Date.now().toString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set(\"aliceUserId\", pm.response.json().user_id);",
                  "pm.test(\"Location header\", function () { pm.expect(pm.response.headers.get(\"Location\")).to.include(pm.response.json().user_id); });"
                ]
              }
            }
          ]
        },
