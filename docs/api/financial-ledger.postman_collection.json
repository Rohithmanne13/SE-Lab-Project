        {
          "name": "Deposit 50000 to Alice (ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{adminKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{depositKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/wallets/{{aliceWalletId}}/deposits",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "wallets",
                "{{aliceWalletId}}",
                "deposits"
              ]
            },
            "description": "FR-1.6 - ADMIN key and Idempotency-Key. 50000 minor units = INR 500.00.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 50000,\n  \"currency\": \"INR\",\n  \"description\": \"Initial funding\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"depositKey\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set(\"depositTransactionId\", pm.response.json().transaction_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Transfer 12550 from Alice to Bob",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{clientKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{transferKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/transfers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "transfers"
              ]
            },
            "description": "FR-2 - CLIENT key and a new Idempotency-Key. 12550 = INR 125.50.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source_wallet_id\": \"{{aliceWalletId}}\",\n  \"destination_wallet_id\": \"{{bobWalletId}}\",\n  \"amount\": 12550,\n  \"currency\": \"INR\",\n  \"description\": \"Dinner\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"transferKey\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set(\"transferTransactionId\", pm.response.json().transaction_id);",
                  "pm.test(\"not a replay\", function () { pm.expect(pm.response.headers.get(\"Idempotent-Replayed\")).to.eql(undefined); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Retry the same transfer (same Idempotency-Key)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{clientKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{transferKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/transfers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "transfers"
              ]
            },
            "description": "FR-2.6 - the stored response is replayed with Idempotent-Replayed: true; no second posting.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source_wallet_id\": \"{{aliceWalletId}}\",\n  \"destination_wallet_id\": \"{{bobWalletId}}\",\n  \"amount\": 12550,\n  \"currency\": \"INR\",\n  \"description\": \"Dinner\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"replayed\", function () { pm.expect(pm.response.headers.get(\"Idempotent-Replayed\")).to.eql(\"true\"); });",
                  "pm.test(\"same transaction\", function () { pm.expect(pm.response.json().transaction_id).to.eql(pm.collectionVariables.get(\"transferTransactionId\")); });"
                ]
              }
            }
          ]
        },
