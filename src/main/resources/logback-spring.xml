<?xml version="1.0" encoding="UTF-8"?>
<!-- Logging (NFR-OBS-1, SEC-7): normal console logs, plus one structured JSON line per request on the
     "ledger.access" logger, printed without any prefix so every access line is valid JSON. -->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>
    <appender name="ACCESS" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%msg%n</pattern>
        </encoder>
    </appender>
    <logger name="ledger.access" level="INFO" additivity="false">
        <appender-ref ref="ACCESS"/>
    </logger>
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
